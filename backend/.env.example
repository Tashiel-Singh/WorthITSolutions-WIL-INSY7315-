# Copy to .env (never commit .env). In Azure, these come from Key Vault.
DATABASE_URL="postgresql://medflow_app:CHANGE_ME@localhost:5432/medflow?schema=public"
JWT_SECRET="replace-with-64+ random chars (openssl rand -hex 48)"
JWT_ACCESS_EXPIRES="15m"
REFRESH_TOKEN_DAYS=7
BCRYPT_COST=12
PORT=4000
CORS_ORIGIN="http://localhost:5173"

// MedFlow - Role 3 schema. Physical realisation of the Task 1 ERD (Section 12.2),
// extended with Transaction / Asset / Expense (channel, bulkRevenue, quantity) for the
// tax, revenue-segregation and bulk-discount services, plus security/POPIA tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  PHARMACY_MANAGER
  PHARMACIST
  DOCTOR
  PSYCHIATRIST
  PATIENT
  LEISURE_CLIENT
}

enum Channel {
  PATIENT
  PHARMACY
  LEISURE
}

enum PoolType {
  RETAIL
  BULK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  OVERDUE
  PAID
}

enum PrescriberType {
  DOCTOR
  PSYCHIATRIST
  PHARMACIST
}

enum Category {
  CBD_OIL
  CBD_CAPSULE
  CBD_TOPICAL
  CBD_EDIBLE
  HOMEOPATHIC_REMEDY
  HOMEOPATHIC_TINCTURE
  HOMEOPATHIC_CREAM
  HOMEOPATHIC_DROPS
  BULK_PACK
  WELLNESS
}

model User {
  id                  String    @id @default(uuid()) @map("user_id") @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  role                Role
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  pharmacy      Pharmacy?
  patient       Patient?
  prescriber    Prescriber?
  refreshTokens RefreshToken[]
  consents      ConsentRecord[]
  auditLogs     AuditLog[]

  @@index([role])
  @@map("users")
}

// 1:1 subtype of users (shared PK/FK)
model Pharmacy {
  id              String  @id @map("pharmacy_id") @db.Uuid
  name            String
  licenseNumber   String  @unique @map("license_number")
  creditLimit     Decimal @default(0) @map("credit_limit") @db.Decimal(12, 2)
  creditTermsDays Int     @default(30) @map("credit_terms_days")

  user   User    @relation(fields: [id], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("pharmacies")
}

model Patient {
  id            String    @id @default(uuid()) @map("patient_id") @db.Uuid
  userId        String?   @unique @map("user_id") @db.Uuid
  name          String
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  contactNumber String?   @map("contact_number")
  anonymisedAt  DateTime? @map("anonymised_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]

  @@map("patients")
}

// Doctor / Psychiatrist / Pharmacist consolidated with a type discriminator
model Prescriber {
  id             String         @id @default(uuid()) @map("prescriber_id") @db.Uuid
  userId         String?        @unique @map("user_id") @db.Uuid
  name           String
  hpcsaNumber    String         @unique @map("hpcsa_number")
  type           PrescriberType
  practice       String?
  specialization String?
  commissionRate Decimal        @default(0) @map("commission_rate") @db.Decimal(5, 4)

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]

  @@index([type])
  @@map("prescribers")
}

model Product {
  id        String   @id @default(uuid()) @map("product_id") @db.Uuid
  name      String
  category  Category
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  bulkPrice Decimal  @map("bulk_price") @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  prescriptions  Prescription[]

  @@index([category])
  @@index([name])
  @@map("products")
}

// Separate rows per pool so the same product can have independent RETAIL and BULK stock
model InventoryItem {
  id               String    @id @default(uuid()) @map("item_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  poolType         PoolType  @map("pool_type")
  quantityOnHand   Int       @map("quantity_on_hand")
  reorderThreshold Int       @default(0) @map("reorder_threshold")
  expiryDate       DateTime? @map("expiry_date") @db.Date

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, poolType])
  @@index([expiryDate])
  @@map("inventory_items")
}

model Order {
  id          String      @id @default(uuid()) @map("order_id") @db.Uuid
  pharmacyId  String      @map("pharmacy_id") @db.Uuid
  orderDate   DateTime    @default(now()) @map("order_date")
  status      OrderStatus @default(PENDING)
  channel     Channel     @default(PHARMACY)
  quantity    Int         @default(0)
  bulkRevenue Decimal     @default(0) @map("bulk_revenue") @db.Decimal(12, 2)

  pharmacy     Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  invoice      Invoice?
  transactions Transaction[]

  @@index([pharmacyId, status])
  @@index([orderDate])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @map("order_item_id") @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Invoice {
  id          String        @id @default(uuid()) @map("invoice_id") @db.Uuid
  orderId     String        @unique @map("order_id") @db.Uuid // UNIQUE enforces 1:1 Order->Invoice in the DB
  vatAmount   Decimal       @map("vat_amount") @db.Decimal(12, 2)
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  dueDate     DateTime      @map("due_date") @db.Date
  status      InvoiceStatus @default(SENT)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([status, dueDate])
  @@map("invoices")
}

model Payment {
  id          String   @id @default(uuid()) @map("payment_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  amountPaid  Decimal  @map("amount_paid") @db.Decimal(12, 2)
  paymentDate DateTime @default(now()) @map("payment_date")
  method      String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("payments")
}

model Prescription {
  id           String   @id @default(uuid()) @map("prescription_id") @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  prescriberId String   @map("prescriber_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  dosage       String
  dateIssued   DateTime @default(now()) @map("date_issued")

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescriber Prescriber @relation(fields: [prescriberId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([prescriberId])
  @@map("prescriptions")
}

// ---- Financial records consumed by Role 2 services -------------------------

model Transaction {
  id          String   @id @default(uuid()) @map("transaction_id") @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  channel     Channel
  amount      Decimal  @db.Decimal(12, 2)
  bulkRevenue Decimal  @default(0) @map("bulk_revenue") @db.Decimal(12, 2)
  quantity    Int      @default(0)
  description String?
  occurredAt  DateTime @default(now()) @map("occurred_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([channel, occurredAt])
  @@index([occurredAt])
  @@map("transactions")
}

model Asset {
  id          String   @id @default(uuid()) @map("asset_id") @db.Uuid
  name        String
  cost        Decimal  @db.Decimal(12, 2)
  depreciable Boolean  @default(true)
  channel     Channel  @default(PHARMACY)
  bulkRevenue Decimal  @default(0) @map("bulk_revenue") @db.Decimal(12, 2)
  quantity    Int      @default(1)
  acquiredAt  DateTime @default(now()) @map("acquired_at")

  @@index([channel])
  @@map("assets")
}

model Expense {
  id          String   @id @default(uuid()) @map("expense_id") @db.Uuid
  description String
  amount      Decimal  @db.Decimal(12, 2)
  channel     Channel  @default(PHARMACY)
  bulkRevenue Decimal  @default(0) @map("bulk_revenue") @db.Decimal(12, 2)
  quantity    Int      @default(1)
  incurredAt  DateTime @default(now()) @map("incurred_at")

  @@index([channel, incurredAt])
  @@map("expenses")
}

// ---- Security / POPIA ------------------------------------------------------

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") // SHA-256 of the token; raw token is never stored
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ConsentRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  purpose   String // e.g. DATA_STORAGE, REFILL_REMINDERS
  granted   Boolean
  createdAt DateTime @default(now()) @map("created_at") // timestamped per POPIA

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consent_records")
}

// Append-only (enforced by DB trigger in migration 2). Retain >= 5 years.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
